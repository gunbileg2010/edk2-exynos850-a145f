[Defines]
  INF_VERSION                    = 0x00010019
  BASE_NAME                      = RegDump
  FILE_GUID                      = 5e3a7c14-9b2d-4f6a-8d11-a145f0850d01
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = RegDumpMain

[Sources]
